{
  "name": "warehouse-management-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "仓库管理系统前端 - 基于 Vue 3 + Vite + Element Plus 的现代化 WMS 解决方案",
  "author": "开发团队",
  "license": "MIT",
  "keywords": [
    "wms",
    "warehouse",
    "management",
    "vue3",
    "vite",
    "element-plus",
    "inventory",
    "logistics"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite --config config/vite.config.js",
    "dev:force": "vite --config config/vite.config.js --force",
    "preview": "vite preview --config config/vite.config.js",
    "build": "vite build --config config/vite.config.js",
    "build:staging": "vite build --config config/vite.config.js --mode staging",
    "build:analyze": "cross-env VITE_BUILD_ANALYZE=true vite build --config config/vite.config.js",
    "lint": "eslint src --config config/eslint.config.js",
    "lint:fix": "eslint src --config config/eslint.config.js --fix",
    "format": "prettier --write \"src/**/*.{js,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,json,css,scss,md}\"",
    "check": "npm run lint && npm run format:check",
    "fix": "npm run lint:fix && npm run format",
    "test": "vitest run --config config/vitest.config.js",
    "test:watch": "vitest --config config/vitest.config.js",
    "test:coverage": "vitest run --config config/vitest.config.js --coverage",
    "test:e2e": "cypress run --config-file config/cypress.config.js --headless",
    "test:e2e:open": "cypress open --config-file config/cypress.config.js",
    "test:e2e:chrome": "cypress run --config-file config/cypress.config.js --browser chrome --headless",
    "test:e2e:edge": "cypress run --config-file config/cypress.config.js --browser edge --headless",
    "test:e2e:firefox": "cypress run --config-file config/cypress.config.js --browser firefox --headless",
    "check:deps": "npm outdated",
    "check:audit": "npm audit --audit-level=moderate",
    "check:all": "npm run lint && npm run check:deps && npm run check:audit",
    "prepare": "husky || true"
  },
  "scriptsDescription": {
    "dev": "🚀 启动开发服务器 (http://localhost:5173)",
    "dev:force": "🚀 强制启动开发服务器（清除缓存）",
    "preview": "👁️ 预览生产构建",
    "build": "📦 构建生产环境",
    "build:staging": "📦 构建预发布环境",
    "build:analyze": "📊 构建并分析包体积",
    "lint": "🔍 检查代码规范(ESLint)",
    "lint:fix": "🔧 自动修复代码规范问题",
    "format": "✨ 格式化代码(Prettier)",
    "format:check": "🔍 检查代码格式",
    "check": "🔍 检查代码规范和格式",
    "fix": "🔧 修复代码规范和格式",
    "test": "🧪 运行单元测试(Vitest)",
    "test:watch": "🧪 监听模式运行单元测试",
    "test:coverage": "📈 运行单元测试并生成覆盖率报告",
    "test:e2e": "🎭 运行端到端测试(Cypress)",
    "test:e2e:open": "🎭 打开Cypress测试界面",
    "test:e2e:chrome": "🎭 使用Chrome运行端到端测试",
    "test:e2e:edge": "🎭 使用Edge运行端到端测试",
    "test:e2e:firefox": "🎭 使用Firefox运行端到端测试",
    "check:deps": "📋 检查依赖更新",
    "check:audit": "🔒 检查安全漏洞",
    "check:all": "🔍 执行所有检查",
    "prepare": "🪝 初始化husky钩子"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@lokalise/xlsx": "^0.20.3",
    "axios": "^1.13.5",
    "crypto-js": "^4.2.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.9.0",
    "exceljs": "^4.1.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@pinia/testing": "^0.1.3",
    "@rollup/plugin-alias": "^6.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "@vue/test-utils": "^2.2.7",
    "autoprefixer": "^10.4.23",
    "cross-env": "^7.0.3",
    "cssnano": "^7.1.2",
    "cypress": "^15.8.1",
    "dependency-cruiser": "^17.3.1",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.6.2",
    "express": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.2.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "mochawesome": "^7.1.4",
    "prettier": "^3.7.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass-embedded": "^1.97.3",
    "terser": "^5.46.0",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-progress": "^0.0.7",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^9.4.3"
  }
}