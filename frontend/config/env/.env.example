# ============================================
# 仓库管理系统 - 环境变量配置模板
# ============================================
# 使用说明：
# 1. 复制此文件为 .env.development (开发环境) 或 .env.production (生产环境)
# 2. 根据实际环境修改以下配置值
# 3. 以 VITE_ 开头的变量会暴露到前端，请勿配置敏感信息
# ============================================

# ============================================
# API 配置
# ============================================
# API 基础路径
# 开发环境：留空使用Vite代理，如 http://localhost:8080
# 生产环境：使用相对路径 /api 或完整URL
VITE_API_BASE_URL=

# API 请求超时时间（毫秒）
VITE_API_TIMEOUT=30000

# ============================================
# 开发服务器配置
# ============================================
# 是否启用代理（开发环境通常启用）
VITE_PROXY_ENABLED=true

# 是否启用HTTPS
VITE_HTTPS_ENABLED=false

# 开发服务器端口
VITE_DEV_PORT=5173

# 启动时是否自动打开浏览器
VITE_OPEN_BROWSER=false

# ============================================
# 构建配置
# ============================================
# 是否启用Source Map（生产环境建议关闭）
VITE_SOURCE_MAP_ENABLED=true

# 是否启用构建分析
VITE_BUILD_ANALYZE=false

# 是否启用Gzip压缩
VITE_COMPRESSION_ENABLED=false

# ============================================
# 应用配置
# ============================================
# 应用版本号
VITE_APP_VERSION=1.0.0

# 应用标题
VITE_APP_TITLE=仓库管理系统

# 应用环境
development

# ============================================
# 功能开关
# ============================================
# 是否启用Mock数据
VITE_ENABLE_MOCK=false

# 是否启用调试模式
VITE_ENABLE_DEBUG=false

# ============================================
# 监控配置
# ============================================
# 是否启用性能监控
VITE_ENABLE_PERFORMANCE_MONITOR=true

# 是否启用错误上报
VITE_ENABLE_ERROR_REPORT=true

# ============================================
# 安全提示
# ============================================
# ⚠️ 警告：以下类型的信息禁止配置在此文件中：
# - API密钥、访问令牌等敏感凭证
# - 数据库连接字符串
# - 服务器内部地址或端口
# - 任何不应暴露给前端的配置
#
# 敏感信息应通过以下方式管理：
# 1. 后端环境变量
# 2. 配置中心（如Apollo、Nacos）
# 3. 密钥管理系统（如Vault）
# ============================================
