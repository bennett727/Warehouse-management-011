# ============================================
# 仓库管理系统 - 生产环境配置
# ============================================
# 重要提示：
# 1. 此文件包含生产环境配置
# 2. 请勿将此文件提交到版本控制
# 3. 部署前请检查所有配置项
# ============================================

# ============================================
# API 配置
# ============================================
# API 基础路径（生产环境使用相对路径，由Nginx代理）
VITE_API_BASE_URL=/api

# API 请求超时时间（毫秒）
VITE_API_TIMEOUT=30000

# ============================================
# 构建配置
# ============================================
# 生产环境关闭Source Map，防止源码泄露
VITE_SOURCE_MAP_ENABLED=false

# 启用Gzip压缩
VITE_COMPRESSION_ENABLED=true

# 不启用构建分析
VITE_BUILD_ANALYZE=false

# ============================================
# 应用配置
# ============================================
# 应用版本号
VITE_APP_VERSION=1.0.0

# 应用标题
VITE_APP_TITLE=仓库管理系统

# 应用环境
VITE_APP_ENV=production

# ============================================
# 功能开关
# ============================================
# 生产环境禁用Mock数据
VITE_ENABLE_MOCK=false

# 生产环境禁用调试模式
VITE_ENABLE_DEBUG=false

# ============================================
# 监控配置
# ============================================
# 启用性能监控
VITE_ENABLE_PERFORMANCE_MONITOR=true

# 启用错误上报
VITE_ENABLE_ERROR_REPORT=true

# ============================================
# 安全配置
# ============================================
# 本地存储加密密钥（已自动生成，请勿修改）
VITE_STORAGE_KEY=lSyySMgXdgHDEQHUibfrAzMwduyRY+FcioZLhOVfyAg=

# ============================================
# 地图配置（可选）
# ============================================
# 高德地图API密钥（如需地图功能，请申请）
# 申请地址：https://lbs.amap.com/
VITE_AMAP_KEY=

# 默认地图中心位置（广州）
VITE_MAP_DEFAULT_LNG=113.2644
VITE_MAP_DEFAULT_LAT=23.1291
VITE_MAP_DEFAULT_ZOOM=11

# ============================================
# 安全提示
# ============================================
# ⚠️ 警告：以下类型的信息禁止配置在此文件中：
# - API密钥、访问令牌等敏感凭证
# - 数据库连接字符串
# - 服务器内部地址或端口
# - 任何不应暴露给前端的配置
#
# 敏感信息应通过以下方式管理：
# 1. 后端环境变量
# 2. 配置中心（如Apollo、Nacos）
# 3. 密钥管理系统（如Vault）
# ============================================
