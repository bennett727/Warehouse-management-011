<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot父项目配置 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath />
    </parent>

    <!-- 项目基本信息 -->
    <groupId>com.backend</groupId>
    <artifactId>spring_boot</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>spring_boot</name>
    <description>仓库管理系统后端服务</description>
    <url />

    <!-- 项目许可证信息 -->
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <!-- 开发者信息 -->
    <developers>
        <developer>
            <name>Backend Team</name>
            <email>backend@example.com</email>
            <organization>Example Inc.</organization>
            <organizationUrl>https://example.com</organizationUrl>
        </developer>
    </developers>

    <!-- 版本控制信息 -->
    <scm>
        <connection>scm:git:https://github.com/yourusername/spring_boot.git</connection>
        <developerConnection>scm:git:https://github.com/yourusername/spring_boot.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/yourusername/spring_boot</url>
    </scm>

    <!-- 项目属性配置 -->
    <properties>
        <!-- Java版本配置 -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- 启动类配置 -->
        <start-class>com.backend.Application</start-class>
        <!-- 项目编码配置 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Lombok版本配置 -->
        <lombok.version>1.18.38</lombok.version>
    </properties>

    <!-- 项目依赖管理 -->
    <dependencies>

        <!-- Jackson JSR310模块 - 支持Java 8日期时间类型序列化 -->
        <!-- 用途：解决LocalDateTime等Java 8日期时间类型的JSON序列化问题 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <version>1.12.0</version>
        </dependency>

        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>


        <!-- Spring Data JPA - 数据持久化框架 -->
        <!-- 用途：提供JPA规范实现，简化数据库操作，支持实体映射和Repository模式 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Web - Web应用开发支持 -->
        <!-- 用途：提供RESTful API开发支持，包含Spring MVC、Tomcat等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring WebSocket - WebSocket实时通信支持 -->
        <!-- 用途：提供WebSocket实时通信功能，支持前后端实时数据同步 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- MySQL数据库驱动 - 生产环境数据库 -->
        <!-- 用途：连接MySQL数据库，用于生产环境数据存储 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2嵌入式数据库 - 开发/测试环境数据库 -->
        <!-- 用途：提供内存数据库支持，用于开发和测试环境快速启动 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot测试框架 -->
        <!-- 用途：提供单元测试和集成测试支持，包含JUnit、Mockito等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security - 安全认证与授权框架 -->
        <!-- 用途：提供身份认证、权限控制、密码加密等安全功能 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Security测试支持 -->
        <!-- 用途：提供Spring Security相关的测试工具和方法 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Jakarta Bean Validation API - 参数校验规范 -->
        <!-- 用途：提供参数校验注解（@NotNull、@Size、@Pattern等） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- Hibernate Validator - Bean Validation实现 -->
        <!-- 用途：实现Jakarta Bean Validation规范，提供校验逻辑 -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>

        <!-- JJWT API - JWT令牌生成与解析 -->
        <!-- 用途：提供JWT令牌的生成、解析和验证功能，用于无状态认证 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.3</version>
        </dependency>

        <!-- JJWT Implementation - JWT实现 -->
        <!-- 用途：提供JWT的具体实现，包括签名算法和令牌处理 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>

        <!-- JJWT Jackson - JSON序列化支持 -->
        <!-- 用途：提供JWT与JSON之间的序列化和反序列化支持 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Apache POI - Excel文件处理(.xls格式) -->
        <!-- 用途：提供Excel文件的读取和写入功能，支持.xls格式 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- Apache POI OOXML - Excel文件处理(.xlsx格式) -->
        <!-- 用途：提供Excel文件的读取和写入功能，支持.xlsx格式 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- Spring Cache - 缓存抽象层 -->
        <!-- 用途：提供缓存抽象，支持多种缓存实现，提升系统性能 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Caffeine Cache - 高性能缓存库 -->
        <!-- 用途：提供高性能的内存缓存实现，支持本地缓存 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Spring Data Redis - Redis缓存支持 -->
        <!-- 用途：提供Redis缓存实现，支持分布式缓存，提升系统性能 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Spring AOP - 面向切面编程 -->
        <!-- 用途：提供AOP支持，实现横切关注点（如日志、事务、权限等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Spring Retry - 重试机制支持 -->
        <!-- 用途：提供重试机制，支持在方法调用失败时自动重试 -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>

        <!-- Mockito Core - 单元测试Mock框架 -->
        <!-- 用途：提供Mock对象创建和行为验证功能，用于单元测试 -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Mockito JUnit Jupiter - JUnit 5集成 -->
        <!-- 用途：提供Mockito与JUnit 5的集成支持 -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Mockito Inline - 支持mock final类和方法 -->
        <!-- 用途：支持对final类和方法的mock，解决Java 17兼容性问题 -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <version>5.2.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Byte Buddy - 运行时代码生成库 -->
        <!-- 用途：支持Java 17的运行时代码生成，用于Mockito等框架 -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.15.10</version>
        </dependency>

        <!-- Byte Buddy Agent - 用于Java代理支持 -->
        <!-- 用途：提供Java代理支持，用于运行时字节码操作 -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <version>1.15.10</version>
        </dependency>

        <!-- Resilience4j - 弹性容错库 -->
        <!-- 用途：提供限流、熔断、重试等弹性容错功能 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.2.0</version>
        </dependency>

        <!-- Redisson - Redis分布式锁客户端 -->
        <!-- 用途：提供分布式锁、信号量、原子操作等分布式协调功能 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>3.27.0</version>
        </dependency>

        <!-- SpringDoc OpenAPI - API文档生成 -->
        <!-- 用途：自动生成OpenAPI 3.0规范文档，支持Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>

        <!-- Lombok - 简化Java代码 -->
        <!-- 用途：通过注解自动生成getter、setter、toString等方法 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit Platform Suite - 测试套件支持 -->
        <!-- 用途：提供JUnit 5测试套件功能 -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ - 流式断言库 -->
        <!-- 用途：提供更优雅的断言API -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Embedded Redis - 嵌入式Redis服务器 -->
        <!-- 用途：为测试提供内存Redis实例 -->
        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>embedded-redis</artifactId>
            <version>1.4.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 构建配置 -->
    <build>
        <plugins>
            <!-- Maven编译插件 - 配置Java编译器和注解处理器 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.38</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <arg>-Xlint:unchecked</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Maven Surefire插件 - 运行单元测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>${skipTests}</skipTests>
                    <excludes>
                        <exclude>**/test/builder/**</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Spring Boot Maven插件 - 打包可执行JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 添加JVM编码参数，确保运行时正确处理中文字符 -->
                    <jvmArguments>-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8
                        -Dconsole.encoding=UTF-8 -Dlog4j2.formatMsgNoLookups=true</jvmArguments>
                    <!-- 系统属性变量配置 -->
                    <systemPropertyVariables>
                        <file.encoding>UTF-8</file.encoding>
                        <sun.jnu.encoding>UTF-8</sun.jnu.encoding>
                    </systemPropertyVariables>
                    <!-- 分层JAR配置 - 优化Docker镜像构建 -->
                    <layers>
                        <enabled>true</enabled>
                        <configuration>${project.basedir}/src/main/resources/layers.xml</configuration>
                    </layers>
                </configuration>
            </plugin>

            <!-- JaCoCo测试覆盖率插件 - 生成代码覆盖率报告 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>true</skip>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.10</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- SpotBugs插件 - 静态代码分析和安全漏洞检测 -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.8.6.6</version>
                <dependencies>
                    <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs</artifactId>
                        <version>4.8.6</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <skip>false</skip>
                    <!-- 分析力度：最大 -->
                    <effort>Max</effort>
                    <!-- 报告阈值：低（报告所有问题） -->
                    <threshold>Low</threshold>
                    <!-- 输出XML格式报告 -->
                    <xmlOutput>true</xmlOutput>
                    <!-- 输出HTML格式报告 -->
                    <htmlOutput>true</htmlOutput>
                    <!-- 包含安全漏洞过滤器 -->
                    <includeFilterFile>config/spotbugs-security-include.xml</includeFilterFile>
                    <!-- 排除不需要修复的警告 -->
                    <excludeFilterFile>config/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <!-- 在verify阶段执行SpotBugs检查 -->
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Checkstyle插件 - 代码风格和安全检查 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.4.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>10.17.0</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <configLocation>config/checkstyle-security.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <violationSeverity>warning</violationSeverity>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- 依赖版本管理 - 统一管理依赖版本号 -->
    <dependencyManagement>
        <dependencies>
        </dependencies>
    </dependencyManagement>
</project>