# =============================================================================
# 仓库管理系统 - 后端生产环境配置
# =============================================================================
# 重要提示：
# 1. 此文件包含生产环境敏感配置
# 2. 请勿将此文件提交到版本控制
# 3. 部署前必须修改所有密码和密钥
# =============================================================================

# =============================================================================
# Java环境配置
# =============================================================================
# Java安装路径（根据实际环境修改）
JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.17.10-hotspot

# Maven配置
MAVEN_OPTS=-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8 -Xmx2g -XX:+UseG1GC

# =============================================================================
# Spring Boot配置
# =============================================================================
# 激活生产环境配置
SPRING_PROFILES_ACTIVE=prod

# 服务端口
SERVER_PORT=8080

# =============================================================================
# 数据库配置（生产环境）
# =============================================================================
# 数据库连接URL
# 格式：jdbc:mysql://host:port/database?参数
DB_URL=jdbc:mysql://localhost:3306/warehouse?useSSL=true&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=false

# 数据库用户名
DB_USERNAME=wms_user

# 数据库密码（必须修改！）
# 生成强密码命令：powershell -Command "[Convert]::ToBase64String((1..24 | ForEach-Object { Get-Random -Maximum 256 } | ForEach-Object { [byte]$_ }))"
DB_PASSWORD=change_this_password_in_production

# =============================================================================
# JWT配置（生产环境）
# =============================================================================
# JWT密钥（必须修改！使用强密钥）
# 生成命令：powershell -Command "[Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 } | ForEach-Object { [byte]$_ }))"
JWT_SECRET=change_this_jwt_secret_in_production_min_64_chars_long_for_security

# Token过期时间（毫秒）
JWT_EXPIRATION=86400000

# 刷新Token过期时间（毫秒）
JWT_REFRESH_EXPIRATION=604800000

# =============================================================================
# CORS配置（生产环境）
# =============================================================================
# 允许的前端域名（必须修改为你的实际域名）
# 多个域名用逗号分隔，例如：https://your-domain.com,https://admin.your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost

# =============================================================================
# 日志配置
# =============================================================================
# 日志级别（生产环境建议WARN或ERROR）
LOG_LEVEL=WARN

# 日志文件路径
LOG_PATH=logs

# =============================================================================
# 文件存储配置
# =============================================================================
# 文件存储类型（local本地存储，oss阿里云OSS）
FILE_STORAGE_TYPE=local

# 本地存储路径
FILE_STORAGE_PATH=/opt/wms/uploads

# =============================================================================
# 监控配置（生产环境）
# =============================================================================
# 启用Prometheus监控
PROMETHEUS_ENABLED=true

# 禁用SkyWalking（如需使用请配置）
SKYWALKING_AGENT_ENABLED=false

# =============================================================================
# 安全配置
# =============================================================================
# 数据库DDL自动更新策略（生产环境使用validate或none）
DDL_AUTO=validate

# =============================================================================
# 部署检查清单
# =============================================================================
# 部署前请确认以下事项：
#
# □ 1. 修改数据库密码（DB_PASSWORD）
# □ 2. 修改JWT密钥（JWT_SECRET），至少64个字符
# □ 3. 配置CORS允许域名（CORS_ALLOWED_ORIGINS）
# □ 4. 确认数据库已创建且用户权限正确
# □ 5. 确认MySQL SSL已启用
# □ 6. 确认服务器防火墙已配置
# □ 7. 确认日志目录有写入权限
# □ 8. 确认文件上传目录有写入权限
# □ 9. 测试数据库连接
# □ 10. 测试JWT密钥强度
#
# =============================================================================
